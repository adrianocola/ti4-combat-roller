{
  "name": "ti4-combat-roller",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p netlify/functions/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aptabase/web": "^0.5.0",
    "@reduxjs/toolkit": "2.11.2",
    "big.js": "6.2.1",
    "framer-motion": "^11.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-redux": "9.2.0",
    "redux-persist": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/big.js": "6.2.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "9.1.4",
    "lint-staged": "15.2.8",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.0.0"
  }
}
